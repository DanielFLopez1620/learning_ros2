<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        
        <joint name="l_base__to__l_wheel1">
            <command_interface name="position">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <command_interface name="velocity">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="l_base__to__l_wheel2">
            <command_interface name="position">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <command_interface name="velocity">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

    </ros2_control>
    
    
    <gazebo reference="l_base">
        <mu1 value="0.6"/>
        <mu2 value="0.3"/>
        <fdir1 value="1 0 0"/>
    </gazebo>
    <gazebo reference="l_cam">
        <mu1 value="0.6"/>
        <mu2 value="0.3"/>
        <fdir1 value="1 0 0"/>
    </gazebo>
    <gazebo reference="l_caster">
        <mu1 value="0.6"/>
        <mu2 value="0.3"/>
        <fdir1 value="1 0 0"/>
    </gazebo>
    <gazebo reference="l_wheel1">
        <mu1 value="0.6"/>
        <mu2 value="0.3"/>
        <fdir1 value="1 0 0"/>
    </gazebo>
    <gazebo reference="l_wheel2">
        <mu1 value="0.6"/>
        <mu2 value="0.3"/>
        <fdir1 value="1 0 0"/>
    </gazebo>

    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
            <parameters>$(find arrow_bot)/config/Robot_controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>